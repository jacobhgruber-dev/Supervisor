{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "small_model": "deepseek/deepseek-flash",
  "default_agent": "supervisor",
  "subagent_depth": 3,
  "agent": {
    "supervisor": {
      "permission": {
        "chrome-devtools_*": "allow",
        "macos-use_*": "allow",
        "screenpipe_search-content": "allow",
        "screenpipe_export-video": "allow",
        "vercel_*": "allow",
        "twenty-first_*": "deny",
        "open-design_*": "deny"
      },
      "options": {}
    },
    "designer": {
      "permission": {
        "twenty-first_*": "allow",
        "open-design_*": "allow",
        "a11y-color-contrast_*": "allow"
      },
      "options": {}
    }
  },
  "command": {},
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect"],
      "enabled": false
    },
    "elevenlabs": {
      "type": "local",
      "command": ["uvx", "elevenlabs-mcp"],
      "enabled": false,
      "environment": {
        "ELEVENLABS_API_KEY": "YOUR_ELEVENLABS_KEY"
      }
    },
    "railway": {
      "type": "local",
      "command": ["railway", "mcp"],
      "enabled": false
    },
    "screenpipe": {
      "type": "local",
      "command": ["npx", "-y", "screenpipe-mcp@latest"],
      "enabled": false
    },
    "macos-automator": {
      "type": "local",
      "command": ["npx", "-y", "--package", "@steipete/macos-automator-mcp", "macos-automator-mcp"],
      "enabled": false
    },
    "yt-dlp": {
      "type": "local",
      "command": ["npx", "-y", "@kevinwatt/yt-dlp-mcp@latest"],
      "enabled": false
    },
    "vercel": {
      "type": "local",
      "command": ["npx", "-y", "vercel-mcp-pro"],
      "enabled": false,
      "environment": {
        "VERCEL_TOKEN": "YOUR_VERCEL_TOKEN"
      }
    },
    "gemini-api-docs": {
      "type": "local",
      "command": ["uvx", "--from", "git+https://github.com/philschmid/gemini-api-docs-mcp", "gemini-docs-mcp"],
      "enabled": false
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": false
    },
    "github": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"],
      "enabled": false,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_TOKEN"
      }
    },
    "macos-use": {
      "type": "local",
      "command": ["/usr/local/bin/mcp-server-macos-use"],
      "enabled": false
    },
    "twenty-first": {
      "type": "local",
      "command": ["npx", "-y", "@21st-dev/mcp"],
      "enabled": false
    },
    "a11y-color-contrast": {
      "type": "local",
      "command": ["npx", "-y", "a11y-color-contrast-mcp"],
      "enabled": true
    },
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "enabled": false,
      "environment": {
        "FIRECRAWL_API_KEY": "YOUR_FIRECRAWL_KEY"
      }
    }
  },
  "permission": {
    "chrome-devtools_*": "allow",
    "firecrawl_*": "allow",
    "macos-use_*": "allow",
    "vercel_*": "allow",
    "twenty-first_*": "deny",
    "open-design_*": "deny",
    "a11y-color-contrast_*": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "provider": {
    "ollama": {
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      }
    }
  },
  "plugin": ["observer-bridge.js"],
  "disabled_providers": []
}
