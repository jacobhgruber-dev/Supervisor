{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "default_agent": "supervisor",
  "agent": {
    "supervisor": {
      "permission": {
        "chrome-devtools_*": "allow",
        "macos-use_*": "allow",
        "screenpipe_search-content": "allow",
        "screenpipe_export-video": "allow",
        "vercel_*": "allow"
      },
      "options": {}
    }
  },
  "command": {},
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect"],
      "enabled": false
    },
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "enabled": false,
      "environment": {
        "FIRECRAWL_API_KEY": "YOUR_FIRECRAWL_KEY"
      }
    },
    "elevenlabs": {
      "type": "local",
      "command": ["uvx", "elevenlabs-mcp"],
      "enabled": false,
      "environment": {
        "ELEVENLABS_API_KEY": "YOUR_ELEVENLABS_KEY"
      }
    },
    "railway": {
      "type": "local",
      "command": ["railway", "mcp"],
      "enabled": false
    },
    "screenpipe": {
      "type": "local",
      "command": ["npx", "-y", "screenpipe-mcp@latest"],
      "enabled": false
    },
    "macos-automator": {
      "type": "local",
      "command": ["npx", "-y", "--package", "@steipete/macos-automator-mcp", "macos-automator-mcp"],
      "enabled": false
    },
    "yt-dlp": {
      "type": "local",
      "command": ["npx", "-y", "@kevinwatt/yt-dlp-mcp@latest"],
      "enabled": false
    },
    "vercel": {
      "type": "local",
      "command": ["npx", "-y", "vercel-mcp-pro"],
      "enabled": false,
      "environment": {
        "VERCEL_TOKEN": "YOUR_VERCEL_TOKEN"
      }
    },
    "gemini-api-docs": {
      "type": "local",
      "command": ["uvx", "--from", "git+https://github.com/philschmid/gemini-api-docs-mcp", "gemini-docs-mcp"],
      "enabled": false
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": false
    },
    "github": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"],
      "enabled": false,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_TOKEN"
      }
    },
    "macos-use": {
      "type": "local",
      "command": ["/usr/local/bin/mcp-server-macos-use"],
      "enabled": false
    }
  },
  "permission": {
    "chrome-devtools_*": "allow",
    "macos-use_*": "allow",
    "vercel_*": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "provider": {
    "deepseek": {
      "name": "DeepSeek",
      "npm": "@ai-sdk/deepseek",
      "options": {
        "apiKey": "YOUR_DEEPSEEK_API_KEY"
      }
    },
    "anthropic": {
      "name": "Anthropic (Claude)",
      "npm": "@ai-sdk/anthropic",
      "models": {
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "tools": true
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "tools": true
        }
      },
      "options": {
        "apiKey": "YOUR_ANTHROPIC_API_KEY"
      }
    },
    "google": {
      "name": "Google (Gemini)",
      "options": {
        "apiKey": "YOUR_GEMINI_API_KEY"
      }
    },
    "ollama": {
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      }
    }
  },
  "plugin": ["observer-bridge.js"],
  "disabled_providers": []
}
