            "linux": { "pip3": ["pip3", "install", "beautifulsoup4"] }
          }
        },
        "requests": {
          "detect": { "python_modules": ["requests"] },
          "install": {
            "windows": { "pip": ["python", "-m", "pip", "install", "requests"] },
            "darwin": { "pip3": ["pip3", "install", "requests"] },
            "linux": { "pip3": ["pip3", "install", "requests"] }
          }
