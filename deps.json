    },
    "media": {
      "label": "Media tools",
      "tools": {
        "ffmpeg": {
          "detect": { "commands": ["ffmpeg"] },
          "install": {
            "windows": { "winget": ["winget", "install", "Gyan.FFmpeg"], "choco": ["choco", "install", "ffmpeg", "-y"], "scoop": ["scoop", "install", "ffmpeg"] },
            "darwin": { "brew": ["brew", "install", "ffmpeg"] },
            "linux": { "apt-get": ["sudo", "apt-get", "install", "-y", "ffmpeg"] }
