            "linux": { "pip3": ["pip3", "install", "py-spy"] }
          }
        },
        "scalene": {
          "detect": { "python_modules": ["scalene"] },
          "install": {
            "windows": { "pip": ["python", "-m", "pip", "install", "scalene"] },
            "darwin": { "pip3": ["pip3", "install", "scalene"] },
            "linux": { "pip3": ["pip3", "install", "scalene"] }
          }
        },
        "coverage": {
          "detect": { "python_modules": ["coverage"] },
          "install": {
            "windows": { "pip": ["python", "-m", "pip", "install", "coverage"] },
            "darwin": { "pip3": ["pip3", "install", "coverage"] },
            "linux": { "pip3": ["pip3", "install", "coverage"] }
          }
        },
        "hypothesis": {
          "detect": { "python_modules": ["hypothesis"] },
