{
  "$comment": "Shared tool manifest consumed by install.sh --doctor and setup.ps1 -Doctor. Schema: categories -> tools -> { detect: { commands[], python_modules[] }, install: { windows|darwin|linux: { manager: argv[] } }, notes }. See DEPENDENCIES.md for the full story.",
  "categories": {
    "core": {
      "label": "Core tools",
      "tools": {
        "node": {
          "detect": { "commands": ["node"] },
          "install": {
            "windows": { "winget": ["winget", "install", "OpenJS.NodeJS.LTS"], "choco": ["choco", "install", "nodejs-lts", "-y"], "scoop": ["scoop", "install", "nodejs-lts"] },
            "darwin": { "brew": ["brew", "install", "node"] },
            "linux": { "apt-get": ["sudo", "apt-get", "install", "-y", "nodejs"] }
          },
          "notes": "OpenCode and every npx-based MCP server run on Node."
        },
        "git": {
          "detect": { "commands": ["git"] },
          "install": {
            "windows": { "winget": ["winget", "install", "Git.Git"], "choco": ["choco", "install", "git", "-y"], "scoop": ["scoop", "install", "git"] },
            "darwin": { "brew": ["brew", "install", "git"] },
            "linux": { "apt-get": ["sudo", "apt-get", "install", "-y", "git"] }
          },
          "notes": "Needed to clone this repo and to produce -Diff output."
        },
        "python": {
          "detect": { "commands": ["python3", "python"] },
          "install": {
            "windows": { "winget": ["winget", "install", "Python.Python.3.12"], "choco": ["choco", "install", "python", "-y"], "scoop": ["scoop", "install", "python"] },
            "darwin": { "brew": ["brew", "install", "python"] },
            "linux": { "apt-get": ["sudo", "apt-get", "install", "-y", "python3"] }
          },
          "notes": "Many quality tools (ruff, mypy, ...) are pip packages."
        },
        "opencode": {
          "detect": { "commands": ["opencode"] },
          "install": {
            "windows": { "npm": ["npm", "install", "-g", "opencode-ai"] },
            "darwin": { "npm": ["npm", "install", "-g", "opencode-ai"] },
            "linux": { "npm": ["npm", "install", "-g", "opencode-ai"] }
          },
          "notes": "The OpenCode app itself. Then run: opencode auth login"
        },
        "uv": {
          "detect": { "commands": ["uv"] },
          "install": {
            "windows": { "winget": ["winget", "install", "astral-sh.uv"], "choco": ["choco", "install", "uv", "-y"], "scoop": ["scoop", "install", "uv"], "pip": ["python", "-m", "pip", "install", "uv"] },
            "darwin": { "brew": ["brew", "install", "uv"] },
            "linux": { "pip3": ["pip3", "install", "uv"] }
          },
          "notes": "Required by several optional MCP servers (elevenlabs, gemini-api-docs)."
        }
      }
    },
    "quality": {
      "label": "Code quality & security tools",
      "tools": {
        "ruff": {
          "detect": { "commands": ["ruff"] },
          "install": {
            "windows": { "pip": ["python", "-m", "pip", "install", "ruff"] },
            "darwin": { "brew": ["brew", "install", "ruff"], "pip3": ["pip3", "install", "ruff"] },
            "linux": { "pip3": ["pip3", "install", "ruff"] }
          }
        },
        "mypy": {
          "detect": { "commands": ["mypy"] },
          "install": {
            "windows": { "pip": ["python", "-m", "pip", "install", "mypy"] },
