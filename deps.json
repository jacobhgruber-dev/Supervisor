            "linux": { "npm": ["npm", "install", "-g", "@railway/cli"] }
          },
          "notes": "Railway CLI - required by the optional railway MCP server."
        },
        "ripgrep": {
          "detect": { "commands": ["rg"] },
          "install": {
            "windows": { "winget": ["winget", "install", "BurntSushi.ripgrep.MSVC"], "choco": ["choco", "install", "ripgrep", "-y"], "scoop": ["scoop", "install", "ripgrep"] },
            "darwin": { "brew": ["brew", "install", "ripgrep"] },
