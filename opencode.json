{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-v4-pro",
  "default_agent": "supervisor",
  "plugin": ["observer-bridge.js"],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect"],
      "enabled": true
    },
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "enabled": false,
      "environment": {
        "FIRECRAWL_API_KEY": "YOUR_FIRECRAWL_KEY"
      }
    },
    "elevenlabs": {
      "type": "local",
      "command": ["uvx", "elevenlabs-mcp"],
      "enabled": false,
      "environment": {
        "ELEVENLABS_API_KEY": "YOUR_ELEVENLABS_KEY"
      }
    },
    "railway": {
      "type": "local",
      "command": ["railway", "mcp"],
      "enabled": false
    },
    "screenpipe": {
      "type": "local",
      "command": ["npx", "-y", "screenpipe-mcp"],
      "enabled": false
    },
    "macos-automator": {
      "type": "local",
      "command": ["npx", "-y", "--package", "@steipete/macos-automator-mcp", "macos-automator-mcp"],
      "enabled": false
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": false
    },
    "github": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"],
      "enabled": false,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_TOKEN"
      }
    }
  },
  "permission": {
    "firecrawl_*": "deny",
    "elevenlabs_*": "deny",
    "railway_*": "deny",
    "screenpipe_*": "deny",
    "macos-automator_*": "deny",
    "context7_*": "deny",
    "github_*": "deny"
  }
}
