{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-v4-pro",
  "plugin": [
    "opencode-gemini-auth@latest",
    "opencode-xai-auth@latest"
  ],
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/deepseek",
      "name": "DeepSeek",
      "options": {
        "apiKey": "YOUR_DEEPSEEK_API_KEY"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro Max",
          "tools": true
        }
      }
    },
    "anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "Anthropic (Claude)",
      "options": {
        "apiKey": "YOUR_ANTHROPIC_API_KEY"
      },
      "models": {
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 Max",
          "tools": true
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8 Max",
          "tools": true
        }
      }
    },
    "gemini-api": {
      "name": "Gemini on API",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai"
      },
      "models": {
        "gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash"
        },
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro"
        },
        "gemini-3.1-flash-lite-preview": {
          "name": "Gemini 3.1 Flash Lite"
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro"
        },
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash"
        },
        "gemini-2.5-flash-lite": {
          "name": "Gemini 2.5 Flash Lite"
        }
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect"],
      "enabled": true
    },
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "enabled": false,
      "environment": {
        "FIRECRAWL_API_KEY": "YOUR_FIRECRAWL_KEY"
      }
    },
    "elevenlabs": {
      "type": "local",
      "command": ["uvx", "elevenlabs-mcp"],
      "enabled": false,
      "environment": {
        "ELEVENLABS_API_KEY": "YOUR_ELEVENLABS_KEY"
      }
    },
    "railway": {
      "type": "local",
      "command": ["railway", "mcp"],
      "enabled": false
    },
    "screenpipe": {
      "type": "local",
      "command": ["npx", "-y", "screenpipe-mcp"],
      "enabled": false
    },
    "macos-automator": {
      "type": "local",
      "command": ["npx", "-y", "--package", "@steipete/macos-automator-mcp", "macos-automator-mcp"],
      "enabled": false
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": false
    },
    "github": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"],
      "enabled": false,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_TOKEN"
      }
    }
  },
  "permission": {
    "firecrawl_*": "deny",
    "elevenlabs_*": "deny",
    "railway_*": "deny",
    "screenpipe_*": "deny",
    "macos-automator_*": "deny",
    "context7_*": "deny",
    "github_*": "deny"
  }
}
